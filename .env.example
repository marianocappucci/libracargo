# LibraCargo — variables de entorno. Copiar a .env y completar.
# Ningún valor real de este archivo entra al repo.

# PostgreSQL es el único motor: no hay default a SQLite a propósito.
DATABASE_URL=postgresql+psycopg://libracargo:CAMBIAR@db:5432/libracargo

ENTORNO=dev
DEBUG=0

# Huso horario del ecosistema: UTC-3 fijo, sin horario de verano.
TZ=America/Argentina/Buenos_Aires

# LibraAuth (F1)
SESSION_SECRET=CAMBIAR
