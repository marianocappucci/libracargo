# LibraCargo — variables de entorno. Copiar a .env y completar.
# Ningún valor real de este archivo entra al repo.

# PostgreSQL es el único motor: no hay default a SQLite a propósito.
# Local, contra el compose: el host es el nombre del servicio.
DATABASE_URL=postgresql+psycopg://libracargo:CAMBIAR@libracargo-postgres:5432/libracargo
LIBRACARGO_POSTGRES_PASSWORD=CAMBIAR

ENTORNO=dev
DEBUG=0

# Huso horario del ecosistema: UTC-3 fijo, sin horario de verano.
TZ=America/Argentina/Buenos_Aires

# Firma de la cookie de sesión. Sin esto la app NO levanta (salvo
# ENV=development, que sólo sirve para correr local).
SECRET_KEY=CAMBIAR

# Usuario inicial. Fail-closed: sin la contraseña la app no arranca, en vez de
# crear un admin con una clave que nadie eligió.
LIBRACARGO_ADMIN_USERNAME=admin
LIBRACARGO_ADMIN_PASSWORD=CAMBIAR
